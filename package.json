{
  "name": "dial-tone-from-the-grave",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "optimize-assets": "gltf-transform optimize assets-src/phone/we500.glb public/models/we500.glb --compress meshopt --texture-compress webp --texture-size 2048 --join false --flatten false --instance false --simplify false && cwebp -q 85 assets-src/textures/dark_wooden_planks_diff_2k.jpg -o public/textures/dark_wooden_planks_diff_2k.webp"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@supabase/supabase-js": "2.49.4",
    "next": "16.4.6",
    "postprocessing": "^6.39.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "0.177.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "1.52.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.177.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "3.23.2",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "15.5.2",
    "prettier": "3.5.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@12.18.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,md}": [
      "prettier --write"
    ]
  }
}
