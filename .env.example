# ─── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL (find it in Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (sb_publishable_...) - safe to expose in browser code
# Replaces the legacy anon key. Find it in Settings > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Supabase secret key (sb_secret_...) - server-side only, NEVER expose to the browser
# Replaces the legacy service_role key. Find it in Settings > API Keys.
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Anthropic API key - server-side only, NEVER expose to the browser
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Claude model to use for operator calls (default shown)
ANTHROPIC_MODEL=claude-haiku-5-5

# ─── Rate limits (all optional, defaults shown) ───────────────────────────────
# Max operator (Claude) calls per IP per hour
OPERATOR_LIMIT_PER_IP_PER_HOUR=20

# Max search calls per IP per hour
SEARCH_LIMIT_PER_IP_PER_HOUR=60

# Max Claude API calls globally per day
CLAUDE_DAILY_GLOBAL_CAP=500

# Max user turns per call before auto hang-up
MAX_TURNS_PER_CALL=6

# Max user turns in a call to a listing from the phone book before auto hang-up
MAX_TURNS_PER_LISTING_CALL=4
# Max characters allowed in a single user message
MAX_INPUT_CHARS=300

# ─── Vercel cron ─────────────────────────────────────────────────────────────
# Secret used to protect the /api/cron/keepalive endpoint
# Set this in the Vercel dashboard and nowhere else
CRON_SECRET=your-cron-secret-here
# ─── Phone rings by itself (all optional, defaults shown) ─────────────────────
# Set to false to keep the phone quiet, for automated tests and demos
NEXT_PUBLIC_RING_IN_ENABLED=true
# Shortest and longest wait, in seconds, before the phone rings by itself
NEXT_PUBLIC_RING_IN_MIN_S=45
NEXT_PUBLIC_RING_IN_MAX_S=120
# Most times the phone rings by itself in one browser tab
NEXT_PUBLIC_RING_IN_MAX_PER_SESSION=2
